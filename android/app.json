{
  "expo": {
    "name": "RT/RW-SID CONNECT",
    "slug": "rt-rw-sid-connect",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "rtrwsidconnect",
    "android": {
      "package": "id.rtrwsid.connect",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#16352C"
      },
      "config": {
        "googleMaps": {
          "apiKey": "process.env.GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "id.rtrwsid.connect",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-sensors",
        {
          "motionPermission": "RT/RW-SID CONNECT menggunakan sensor gerak untuk mendeteksi kemungkinan kejadian darurat."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RT/RW-SID CONNECT menggunakan lokasi hanya saat Anda meminta peta atau bantuan darurat."
        }
      ]
    ]
  }
}
